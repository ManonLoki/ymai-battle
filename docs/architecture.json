  "cards": [
    {
      "dot": "cyan",
      "title": "场景层",
      "items": [
        "四个主场景加 FighterView 全部收在 scenes/",
        "静态节点写在 .tscn，脚本只做绑定和编排",
        "battle.gd 不做胜负判定，只负责演出"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据链路",
      "items": [
        "服务端返回逻辑用户排行桶",
        "把 ranking 桶映成 RankedUser 再排名",
        "tokens 既是排名依据，也是最大生命值"
      ]
    },
    {
      "dot": "violet",
      "title": "战斗解算",
      "items": [
        "任何判定都是掷骰，没有写死结果的效果",
        "技能按同名字段相加，加一条只需补一行表",
        "RollSource 可预置点数，测试能指定每一击"
      ]
    },
    {
      "dot": "amber",
      "title": "平台适配与共用件",
      "items": [
        "TvRemote 四个场景各自 install()，统一遥控器返回与焦点",
        "CursorController 是 autoload，换场景不重载光标贴图",
        "DayClock 每次现取日期，跨天自动重拉榜单"
      ]
    }
  ]
