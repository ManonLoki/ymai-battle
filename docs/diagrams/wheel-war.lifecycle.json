  "cards": [
    {
      "dot": "cyan",
      "title": "开场就把这一场定型了",
      "items": [
        "擂主耐打度 = 每场标准命中数 × 挑战者人数，所以两边需要的有效命中总数相等",
        "胜率先按人均战力比算出目标，再反解成几个百分点的命中率偏移喂给每一次判定",
        "偏移要扣掉擂主多带的 buff 当量和多摸的技能张数，否则多开 agent 等于白嫖胜率"
      ]
    },
    {
      "dot": "amber",
      "title": "回合里谁先动",
      "items": [
        "挑战者永远先手；擂主只有还活着才还手，所以先手方偶尔能抢到一个回合的便宜",
        "挑战者可能死在自己的毒或混乱自伤上，这种情况擂主这回合不再出手，直接换人",
        "换人不给擂主回血——他那条血条要从第一位一路扛到最后一位"
      ]
    },
    {
      "dot": "rose",
      "title": "只有两个出口",
      "items": [
        "ONGOING 是唯一的活动状态，胜负判定收在 WheelWar 里，场景脚本不自己比 outcome",
        "擂主倒下立刻结束，哪怕队列里还有人没上场",
        "队列排空即擂主守住全场；空名单时 outcome 留在 ONGOING，由调用方按人数拦下"
      ]
    }
  ]
