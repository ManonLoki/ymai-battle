; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="YMAIBattle"
config/version="1.1.1"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="uid://dr0v5kk6exdih"

[autoload]

CursorController="*res://scripts/cursor_controller.gd"
WebLaunchConfigBootstrap="*res://scripts/web_launch_config.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/initial_position_type=4
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="res://assets/cursors/arrow.png"
mouse_cursor/custom_image_hotspot=Vector2(1, 1)

[gui]

timers/tooltip_delay_sec=0.0

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
